{
  "name": "sonalia",
  "version": "1.0.3",
  "description": "Sonalia Dental Management",
  "main": "main.js",
  "scripts": {
    "dev:css": "npx tailwindcss -i ./src/renderer/styles/style.css -o ./src/renderer/styles/output.css --watch",
    "dev": "electron .",
    "start": "concurrently \"npm run dev:css\" \"npm run dev\"",
    "build:css": "npx tailwindcss -i ./src/renderer/styles/style.css -o ./src/renderer/styles/output.css",
    "mail:status": "node scripts/check-mail-service.js",
    "mail:bootstrap": "node scripts/bootstrap-system-mail-auth.js",
    "postinstall": "electron-builder install-app-deps",
    "pack": "npm run build:css && electron-builder --dir",
    "build:win": "npm run build:css && electron-builder --win nsis",
    "dist": "npm run build:css && electron-builder",
    "publish:win": "npm run build:css && electron-builder --win nsis --publish always",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "author": "Nerick Roxe",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.1",
    "googleapis": "^166.0.0",
    "nodemailer": "^7.0.10",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "jest": "^29.7.0",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.6"
  },
  "build": {
    "appId": "com.nerick.sonalia.app",
    "productName": "Sonalia",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "icon": "src/renderer/assets/icons/app.ico",
    "directories": {
      "output": "dist_installer"
    },
    "npmRebuild": false,
    "files": [
      "main.js",
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/sqlite3/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "src/renderer/assets/icons/app.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dev-Roxe",
        "repo": "Sonalia",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "src/renderer/assets/icons/app.ico",
      "uninstallerIcon": "src/renderer/assets/icons/app.ico",
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sonalia"
    }
  }
}
