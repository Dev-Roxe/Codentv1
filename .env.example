# Configuracion SMTP para Nodemailer
# Usa credenciales locales. No subas tu archivo .env real.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM_NAME=Sonalia

# Desarrollo
NODE_ENV=development

# Opcional: bootstrap de admin local
INIT_ADMIN_NAME=Admin
INIT_ADMIN_EMAIL=admin@ejemplo.com
INIT_ADMIN_PASSWORD=cambia_esta_contrasena_segura
