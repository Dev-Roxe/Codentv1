# Remitente oficial y fijo del sistema.
SYSTEM_SENDER_EMAIL=softwaresonalia@gmail.com

# Token OAuth de la cuenta oficial del sistema.
# Se genera una vez con: npm run mail:bootstrap
# Luego se empaqueta automaticamente desde src/main/google/official-mail-token.json
SYSTEM_MAIL_TOKEN_PATH=.sonalia-user-data/official-mail-token.json

# Desarrollo
NODE_ENV=development

# Opcional: bootstrap de admin local
INIT_ADMIN_NAME=Admin
INIT_ADMIN_EMAIL=admin@ejemplo.com
INIT_ADMIN_PASSWORD=cambia_esta_contrasena_segura
